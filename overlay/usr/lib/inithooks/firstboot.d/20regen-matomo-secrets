#!/bin/bash -e
# regenerate matomo secrets and mysql password

. /etc/default/inithooks

diagnostic_step() {
    local name="$1"
    local status
    shift

    printf 'MATOMO-SECRET-DIAG: %s start\n' "$name" >&2
    if "$@"; then
        status=0
    else
        status=$?
    fi
    printf 'MATOMO-SECRET-DIAG: %s status=%s\n' "$name" "$status" >&2

    if [[ "$name" == 'archive' ]]; then
        for log in /var/log/matomo/archive.log /var/log/matomo/error.log; do
            printf 'MATOMO-SECRET-DIAG: %s tail\n' "$log" >&2
            if [[ -r "$log" ]]; then
                tail -n 80 -- "$log" >&2 || true
            else
                printf 'MATOMO-SECRET-DIAG: %s unavailable\n' "$log" >&2
            fi
        done
    fi

    return "$status"
}

CRON_FILE='/etc/cron.d/matomo-archive'
USER="$(diagnostic_step cron-user cut -d ' ' -f 6 "$CRON_FILE")"
CRON_CMD="$(diagnostic_step cron-command cut -d ' ' -f 7- "$CRON_FILE")"
diagnostic_step archive su -s /bin/bash -c "$CRON_CMD" "$USER"

SALT=$(diagnostic_step salt-generation mcookie)
diagnostic_step salt-config \
    "$INITHOOKS_PATH/bin/matomo_config.py" "[General]" "salt" "$SALT"

PASSWORD=$(diagnostic_step password-generation mcookie)
diagnostic_step password-config \
    "$INITHOOKS_PATH/bin/matomo_config.py" "[database]" "password" "$PASSWORD"
diagnostic_step password-rotation \
    "$INITHOOKS_PATH/bin/mysqlconf.py" --user=matomo --pass="$PASSWORD"
